<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/inner_activity_main"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <ImageView
        android:id="@+id/img_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/img_endcard"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_centerInParent="true"/>
    <com.taurusx.tax.ui.TaxMediaView
        android:id="@+id/tax_mediaview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_intersittial_webview"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/second_endcard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/img_endcard2_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="22sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/endcard2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="30dp"
            android:layout_marginHorizontal="30dp"/>
        <TextView
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/endcard2_cta"
            android:background="@drawable/bg_btn_get"
            android:paddingLeft="25dp"
            android:paddingTop="15dp"
            android:paddingRight="25dp"
            android:paddingBottom="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="GET"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="start|top"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="12dp">
        <ImageView
            android:id="@+id/btn_ru_ado"
            android:background="@drawable/taurusx_tax_btn_dark_bg"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/taurusx_ic_more_no_bg"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tax_progress_root"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tax_textView_time"
                android:background="@drawable/taurusx_tax_btn_dark_bg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_marginHorizontal="4dp"/>
            <ImageView
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tax_img_mute"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/taurusx_tax_volume_bg"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginRight="12dp"
        android:layout_alignParentRight="true">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tax_skip"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/taurusx_tax_ic_skip"/>
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tax_skip_click"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"/>
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tax_imageview_close"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/taurusx_ic_close"/>
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tax_imageview_close_click"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"/>
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_endcard2_close"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/taurusx_ic_close"/>
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_endcard2_close_click"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_layout"
        android:background="@drawable/round_9_black_bg"
        android:layout_width="364dp"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp">
            <androidx.cardview.widget.CardView
                android:layout_gravity="center_vertical"
                android:background="#00000000"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginLeft="13dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="26dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="title"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#ffffff"
                    android:id="@+id/desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="desc"
                    android:maxLines="2"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/cta"
            android:background="@drawable/round_7_white_bg"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginLeft="13dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="13dp"
            android:layout_marginBottom="15dp"
            android:text="LEARN MORE"
            android:layout_marginHorizontal="13dp"
            android:layout_marginVertical="15dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_ad"
        android:background="#1a000000"
        android:padding="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/tv_tips"
            android:background="@drawable/taurusx_ic_privacy"
            android:layout_width="14dp"
            android:layout_height="14dp"/>
        <TextView
            android:textSize="8sp"
            android:textColor="#70ffffff"
            android:id="@+id/ad_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AD"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/progress_rl"
        android:background="#000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/tax_media_video_loading"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:indeterminateDrawable="@drawable/taurusx_progress_rotate"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
