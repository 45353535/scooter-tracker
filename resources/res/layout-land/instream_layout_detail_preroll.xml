<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <com.taurusx.tax.ui.TaxMediaView
        android:id="@+id/tax_mediaview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:id="@+id/webview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <Space
        android:id="@+id/bottom_line"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="14dp"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_info"
        android:background="#80000000"
        android:paddingTop="17dp"
        android:layout_width="414dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_alignBottom="@+id/bottom_line"
        android:layout_marginEnd="26dp"
        android:layout_alignParentEnd="true">
        <RelativeLayout
            android:id="@+id/rl_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/icon_view"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_marginBottom="14dp"
                android:layout_alignParentTop="true"
                android:layout_marginStart="24dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="90dp">
                <ImageView
                    android:id="@+id/icon_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/icon_text"
                    android:background="@drawable/round_edc900_100"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:includeFontPadding="false"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_toRightOf="@+id/icon_view"
                android:layout_alignTop="@+id/icon_view"
                android:layout_alignBottom="@+id/icon_view"
                android:layout_marginStart="11dp"
                android:layout_marginEnd="11dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="9sp"
                    android:textColor="#ffffff"
                    android:id="@+id/sponsored"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/taurusx_ads_sponsored"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#e2e2e2"
            android:ellipsize="end"
            android:id="@+id/body"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/cta"
            android:background="@drawable/round_edc900_3"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="14dp"
            android:text="@string/taurusx_ads_know_more"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="25dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/skip_ll"
            android:background="@drawable/round_edc900_100"
            android:visibility="gone"
            android:layout_width="77dp"
            android:layout_height="32dp"
            android:paddingStart="6dp">
            <TextView
                android:textSize="11sp"
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/taurusx_ads_skip"
                android:includeFontPadding="false"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="15dp"
                android:layout_height="wrap_content"
                android:src="@drawable/instream_skip"
                android:adjustViewBounds="true"/>
        </LinearLayout>
        <View
            android:layout_gravity="center"
            android:id="@+id/skip_ll_click"
            android:visibility="gone"
            android:layout_width="77dp"
            android:layout_height="32dp"/>
    </FrameLayout>
    <ProgressBar
        android:id="@+id/progressbar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressDrawable="@xml/progress_bg"
        android:layout_alignParentTop="true"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <ImageView
        android:id="@+id/tax_privacy_tips"
        android:background="@drawable/taurusx_ic_privacy"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_margin="2dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/ado_iv"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/taurusx_ic_more"
        android:layout_alignParentTop="true"
        android:layout_marginStart="25dp"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
