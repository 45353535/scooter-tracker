<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <com.taurusx.tax.ui.TaxMediaView
        android:id="@+id/tax_mediaview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:id="@+id/webview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_info"
        android:background="#80000000"
        android:paddingTop="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:id="@+id/rl_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingStart="15dp"
            android:paddingEnd="18dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/icon_view"
                android:visibility="gone"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="7dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="90dp">
                <ImageView
                    android:id="@+id/icon_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/icon_text"
                    android:background="@drawable/round_ff81a700_100"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:includeFontPadding="false"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/icon_view"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:id="@+id/title"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="8sp"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:id="@+id/body"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="2"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/cta"
            android:background="@drawable/round_ff81a700"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginBottom="12dp"
            android:text="@string/taurusx_ads_know_more"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="11dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true">
        <com.taurusx.tax.ui.CircularProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressbar"
            android:background="@drawable/round_80000000_100"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:cpb_background_progressbar_color="#ffffffff"
            app:cpb_background_progressbar_width="3dp"
            app:cpb_indeterminate_mode="false"
            app:cpb_progress_max="100"
            app:cpb_progressbar_color="#fffa2230"
            app:cpb_progressbar_width="3dp"
            app:cpb_round_border="true"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/skip_ll"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/taurusx_ic_close"
            android:adjustViewBounds="true"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/skip_ll_click"
            android:visibility="invisible"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/tax_privacy_tips"
        android:padding="2dp"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/taurusx_ic_privacy"
        android:scaleType="fitXY"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/ado_iv"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/taurusx_ic_more"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
