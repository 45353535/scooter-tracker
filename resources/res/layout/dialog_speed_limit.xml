<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/titleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/setting_speed_limit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/speedView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titleLabel">
                <TextView
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryText"
                    android:id="@+id/speedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="110"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimaryText"
                    android:id="@+id/unitLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km/h"
                    android:layout_marginStart="4dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/speedLabel"
                    app:layout_constraintStart_toEndOf="@+id/speedLabel"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonOneView"
                android:tag="0"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/none"
                android:textAllCaps="false"
                android:layout_marginStart="24dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintEnd_toStartOf="@+id/buttonTwoView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/speedView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonTwoView"
                android:tag="30"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="20 km/h"
                android:textAllCaps="false"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintEnd_toStartOf="@+id/buttonThreeView"
                app:layout_constraintStart_toEndOf="@+id/buttonOneView"
                app:layout_constraintTop_toBottomOf="@+id/speedView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonThreeView"
                android:tag="40"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="30 km/h"
                android:textAllCaps="false"
                android:layout_marginEnd="24dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/buttonTwoView"
                app:layout_constraintTop_toBottomOf="@+id/speedView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonFourView"
                android:tag="50"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="40 km/h"
                android:textAllCaps="false"
                android:layout_marginStart="24dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintEnd_toStartOf="@+id/buttonFiveView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonThreeView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonFiveView"
                android:tag="60"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="50 km/h"
                android:textAllCaps="false"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintEnd_toStartOf="@+id/buttonSixView"
                app:layout_constraintStart_toEndOf="@+id/buttonFourView"
                app:layout_constraintTop_toBottomOf="@+id/buttonThreeView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonSixView"
                android:tag="70"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="60 km/h"
                android:textAllCaps="false"
                android:layout_marginEnd="24dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/buttonFiveView"
                app:layout_constraintTop_toBottomOf="@+id/buttonThreeView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonSevenView"
                android:tag="80"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="70 km/h"
                android:textAllCaps="false"
                android:layout_marginStart="24dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintEnd_toStartOf="@+id/buttonEightView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonSixView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonEightView"
                android:tag="90"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="80 km/h"
                android:textAllCaps="false"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintEnd_toStartOf="@+id/buttonNineView"
                app:layout_constraintStart_toEndOf="@+id/buttonSevenView"
                app:layout_constraintTop_toBottomOf="@+id/buttonSixView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonNineView"
                android:tag="100"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="90 km/h"
                android:textAllCaps="false"
                android:layout_marginEnd="24dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/buttonEightView"
                app:layout_constraintTop_toBottomOf="@+id/buttonSixView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonTenthView"
                android:tag="110"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:text="100 km/h"
                android:textAllCaps="false"
                android:layout_marginStart="24dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintBottom_toBottomOf="@+id/buttonEleventhView"
                app:layout_constraintEnd_toStartOf="@+id/buttonEleventhView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttonNineView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonEleventhView"
                android:tag="120"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="110 km/h"
                android:textAllCaps="false"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintEnd_toStartOf="@+id/buttonCustomView"
                app:layout_constraintStart_toEndOf="@+id/buttonTenthView"
                app:layout_constraintTop_toBottomOf="@+id/buttonNineView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryText"
                android:id="@+id/buttonCustomView"
                android:background="@drawable/background_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/custom"
                android:textAllCaps="false"
                android:layout_marginEnd="24dp"
                android:backgroundTint="@color/colorDialogButtonBackground"
                app:layout_constraintBottom_toBottomOf="@+id/buttonEleventhView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/buttonEleventhView"
                app:layout_constraintTop_toBottomOf="@+id/buttonNineView"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <View
                android:id="@+id/placeholder"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginBottom="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
