<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/media_view_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"/>
        <RelativeLayout
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5">
            <TextView
                android:textSize="24sp"
                android:gravity="center"
                android:id="@+id/headline_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:text="Headline"/>
            <TextView
                android:textSize="18sp"
                android:gravity="center"
                android:id="@+id/body_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="This is sample advertisement with very cool image or video. Text lines are limited to 5."
                android:maxLines="5"
                android:layout_below="@+id/headline_txt"/>
            <TextView
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/advertiser_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Advertiser"
                android:layout_below="@+id/body_txt"/>
            <Button
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:id="@+id/cta_btn"
                android:padding="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="cta"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:textAllCaps="false"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/center_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_centerInParent="true"/>
    <FrameLayout
        android:id="@+id/icon_container"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="-60dp"
        android:layout_alignTop="@+id/center_view"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
