<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/rt"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_alignParentStart="true">
        <RelativeLayout
            android:id="@+id/webview"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/icon_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="90dp">
            <ImageView
                android:id="@+id/icon_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/icon_text"
                android:background="@drawable/round_ff81a700_100"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:includeFontPadding="false"/>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_info"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="15dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="9sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/body"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#80000000"
            app:cardCornerRadius="3dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/media_card"
                    android:layout_width="match_parent"
                    android:layout_height="80dp">
                    <com.taurusx.tax.ui.TaxMediaView
                        android:id="@+id/tax_mediaview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"/>
                    <ImageView
                        android:id="@+id/image"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
                <TextView
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/cta"
                    android:background="#b2c4ff00"
                    android:layout_width="match_parent"
                    android:layout_height="25dp"
                    android:text="@string/taurusx_ads_know_more"
                    android:layout_below="@+id/media_card"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="12dp"
            android:layout_alignParentEnd="true">
            <com.taurusx.tax.ui.CircularProgressBar
                android:layout_gravity="center"
                android:id="@+id/progressbar"
                android:background="@drawable/round_80000000_100"
                android:visibility="gone"
                android:layout_width="15dp"
                android:layout_height="15dp"
                app:cpb_background_progressbar_color="#ffffffff"
                app:cpb_background_progressbar_width="2dp"
                app:cpb_indeterminate_mode="false"
                app:cpb_progress_max="100"
                app:cpb_progressbar_color="#fffa2230"
                app:cpb_progressbar_width="2dp"
                app:cpb_round_border="true"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/skip_ll"
                android:visibility="gone"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/taurusx_ic_close"
                android:adjustViewBounds="true"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/skip_ll_click"
                android:visibility="invisible"
                android:layout_width="15dp"
                android:layout_height="15dp"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/tax_privacy_tips"
            android:background="@drawable/taurusx_ic_privacy"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginBottom="27dp"
            android:layout_alignBottom="@+id/cardview"
            android:layout_marginStart="3dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/ado_iv"
            android:visibility="gone"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/taurusx_ic_more"
            android:layout_alignParentTop="true"
            android:layout_marginStart="3dp"
            android:layout_alignParentStart="true"/>
    </RelativeLayout>
</RelativeLayout>
