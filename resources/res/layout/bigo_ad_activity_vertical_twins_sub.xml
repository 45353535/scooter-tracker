<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/inter_media_layout"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <sg.bigo.ads.api.MediaView
                android:layout_gravity="center"
                android:id="@+id/inter_media"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/bigo_ad_sub_bottom_component"
            android:background="@color/white"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:paddingStart="65dp"
            android:paddingEnd="10dp">
            <TextView
                android:textSize="20sp"
                android:textColor="#ff333333"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/inter_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bigo_ad_title_default"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff333333"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/bigo_ad_tv_more"
                android:background="@drawable/bigo_ad_grey_btn_background"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </LinearLayout>
    </LinearLayout>
    <sg.bigo.ads.common.view.RoundedImageView
        android:layout_gravity="bottom"
        android:id="@+id/inter_icon"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginBottom="25dp"
        android:layout_marginStart="10dp"/>
</merge>
